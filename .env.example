# Copy to .env and replace the token. Never commit .env.
# SQLite runs with no extra services. Postgres is the intended local database.
DATABASE_URL=sqlite:///./data/aivi.db
# DATABASE_URL=postgresql+psycopg://aivi:aivi@localhost:5432/aivi

API_TOKEN=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234
SESSION_SECRET=replace-with-a-long-random-value
SESSION_HOURS=12
DATA_DIR=./data
EXPORT_DIR=./exports

# Official SET data products require a subscribed API key.
SET_API_KEY=
SET_API_BASE_URL=https://marketplace.set.or.th/api/public

# ChatGPT Pro / Claude Pro / NotebookLM are not called from this process.
# Set an API key before a request that needs a model.
GEMINI_API_KEY=
LLM_CHEAP_PROVIDER=gemini
LLM_STRONG_PROVIDER=gemini
LLM_CHEAP_MODEL=gemini-2.5-flash
LLM_STRONG_MODEL=gemini-2.5-pro
AIVI_ENV=dev
